@using IEsrog.Models

@if (_Order is not null)
{
    <div class="fixed inset-0 z-50 grid place-items-center bg-black bg-opacity-50 p-4" @onclick="Close">
        <div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-2xl" @onclick:stopPropagation="true">
            <div class="mb-5 flex items-start justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-green-600">Your order</p>
                    <h3 class="mt-1 text-xl font-bold text-gray-900">What would you like to do?</h3>
                    <p class="mt-1 text-sm text-gray-500">@_Order.CreatedAt.ToString("dd MMM yyyy") · @_Order.Items.Count item(s)</p>
                </div>
                <button type="button" @onclick="Close" class="text-2xl leading-none text-gray-400 hover:text-gray-700" aria-label="Close">&times;</button>
            </div>
            <div class="mb-6 max-h-40 overflow-y-auto rounded-lg bg-gray-50 p-3 text-sm text-gray-700">
                @foreach (var item in _Order.Items)
                {
                    <div class="flex justify-between border-b border-gray-200 py-2 last:border-0">
                        <span>@item.Name @item.Option</span>
                        <span class="font-semibold">×@item.Qty</span>
                    </div>
                }
            </div>
            <div class="grid gap-3">
                <button type="button" @onclick="Reorder" class="rounded-lg bg-green-600 px-4 py-3 font-semibold text-white hover:bg-green-700">
                    <i class="fa fa-repeat"></i>&nbsp; Reorder these items
                </button>
                <button type="button" @onclick="ViewInvoice" class="rounded-lg border border-gray-300 px-4 py-3 font-semibold text-gray-700 hover:bg-gray-50">
                    <i class="fa fa-file-text-o"></i>&nbsp; View invoice
                </button>
            </div>
        </div>
    </div>
}

@code {
    private Order? _Order;

    [Parameter] public EventCallback<Order> OnReorder { get; set; }
    [Parameter] public EventCallback<Order> OnViewInvoice { get; set; }

    public void Show(Order order)
    {
        _Order = order;
        StateHasChanged();
    }

    private void Close() => _Order = null;

    private async Task Reorder()
    {
        var order = _Order;
        _Order = null;
        if (order is not null)
            await OnReorder.InvokeAsync(order);
    }

    private async Task ViewInvoice()
    {
        var order = _Order;
        _Order = null;
        if (order is not null)
            await OnViewInvoice.InvokeAsync(order);
    }
}
