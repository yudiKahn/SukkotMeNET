@page "/admin/stock"
@inherits PageBase
@using IEsrog.Models
@attribute [Authorize(Policy = Constants.Policies.IsAdmin)]

<div class="w-full px-4 py-20">
    <section class="w-full max-w-5xl mx-auto overflow-hidden bg-white rounded-lg shadow dark:bg-gray-800">
        <header class="flex flex-col gap-4 p-6 border-b border-gray-200 sm:flex-row sm:items-center sm:justify-between dark:border-gray-700">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Products sold</h1>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    Sets are split into their individual products.
                </p>
            </div>

            <label class="text-sm font-medium text-gray-700 dark:text-gray-200">
                Year
                <select class="block w-full px-3 py-2 mt-1 bg-white border border-gray-300 rounded-md dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                        value="@_SelectedYear"
                        @onchange="OnYearChangedAsync"
                        disabled="@_IsLoading">
                    @foreach (var year in _Years)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </label>
        </header>

        <div class="p-6">
            @if (_IsLoading)
            {
                <p class="py-12 text-center text-gray-500 dark:text-gray-400">Loading sales…</p>
            }
            else if (_Sales.Count == 0)
            {
                <p class="py-12 text-center text-gray-500 dark:text-gray-400">
                    No products were sold in @_SelectedYear.
                </p>
            }
            else
            {
                <div class="flex items-end justify-between mb-5">
                    <div>
                        <p class="text-sm text-gray-500 dark:text-gray-400">Total individual products</p>
                        <p class="text-3xl font-bold text-gray-900 dark:text-white">@TotalProducts.ToString("N0")</p>
                    </div>
                    <p class="text-sm text-gray-500 dark:text-gray-400">@_Sales.Count product types</p>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs text-gray-500 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-300">
                            <tr>
                                <th class="px-4 py-3">Product</th>
                                <th class="px-4 py-3 text-right">Quantity sold</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                            @foreach (var sale in _Sales)
                            {
                                <tr class="text-gray-900 dark:text-white">
                                    <td class="px-4 py-3 font-medium">@sale.Key</td>
                                    <td class="px-4 py-3 font-semibold text-right">@sale.Value.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private IReadOnlyList<int> _Years = Array.Empty<int>();
    private IReadOnlyList<KeyValuePair<string, int>> _Sales = Array.Empty<KeyValuePair<string, int>>();
    private int _SelectedYear = DateTime.Now.Year;
    private bool _IsLoading = true;

    private int TotalProducts => _Sales.Sum(sale => sale.Value);

    protected override async Task OnInitializedAsync()
    {
        _Years = await MainService.GetStockYearsAsync();

        if (!_Years.Contains(_SelectedYear) && _Years.Count > 0)
            _SelectedYear = _Years[0];

        await LoadSalesAsync();
    }

    private async Task OnYearChangedAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var year))
            return;

        _SelectedYear = year;
        await LoadSalesAsync();
    }

    private async Task LoadSalesAsync()
    {
        _IsLoading = true;

        try
        {
            var sales = await MainService.GetStockDataAsync(_SelectedYear);
            _Sales = sales
                .OrderByDescending(sale => sale.Value)
                .ThenBy(sale => sale.Key)
                .ToArray();
        }
        finally
        {
            _IsLoading = false;
        }
    }
}
