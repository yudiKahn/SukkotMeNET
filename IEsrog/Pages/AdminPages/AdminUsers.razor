@page "/admin/users"
@using IEsrog.Services
@using IEsrog.Models
@using IEsrog.Extensions
@inherits IEsrog.Models.PageBase
@inject AppStateService _State
@attribute [Authorize(Policy = Constants.Policies.IsAdmin)]


<PageTitle>Users</PageTitle>

<section class="py-1 dark:bg-gray-800">
    <div class="w-full xl:w-8/12 mb-12 xl:mb-0 px-4 mx-auto mt-24">

        <div class="relative flex flex-col min-w-0 break-words bg-white dark:bg-gray-900 w-full mb-6 shadow-lg rounded">
            <div class="rounded-t mb-0 px-4 py-3 border-0">
                <div class="flex flex-wrap items-center">
                    <div class="relative w-full px-4 max-w-full flex-grow flex-1">
                        <h3 class="font-semibold text-base dark:text-gray-200">
                            Users
                        </h3>
                    </div>
                </div>
            </div>

            @if (_EditingUser != null)
            {
                <div class="mx-4 mb-6 rounded border border-blueGray-100 bg-gray-50 dark:bg-gray-800 p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="font-semibold dark:text-gray-200">Edit user</h4>
                        <button type="button" @onclick="CancelEdit" class="text-gray-500 hover:text-gray-700">Cancel</button>
                    </div>

                    <EditForm Model="_EditingUser" OnSubmit="SaveUser">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold mb-2 dark:text-gray-300">First Name</label>
                                <input required @bind="_EditingUser.FirstName" class="p-3 block w-full rounded" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold mb-2 dark:text-gray-300">Last Name</label>
                                <input required @bind="_EditingUser.LastName" class="p-3 block w-full rounded" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold mb-2 dark:text-gray-300">Email</label>
                                <input required type="email" @bind="_EditingUser.Email" class="p-3 block w-full rounded" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold mb-2 dark:text-gray-300">Phone Number</label>
                                <input required @bind="_EditingUser.PhoneNumber" class="p-3 block w-full rounded" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold mb-2 dark:text-gray-300">New Password (optional)</label>
                                <input type="password" @bind="_EditingPassword" class="p-3 block w-full rounded" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold mb-2 dark:text-gray-300">Street</label>
                                <input required @bind="_EditingUser.Address.Street" class="p-3 block w-full rounded" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold mb-2 dark:text-gray-300">City</label>
                                <input required @bind="_EditingUser.Address.City" class="p-3 block w-full rounded" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold mb-2 dark:text-gray-300">State</label>
                                <input required @bind="_EditingUser.Address.State" class="p-3 block w-full rounded" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold mb-2 dark:text-gray-300">Zip</label>
                                <input required type="number" @bind="_EditingUser.Address.Zip" class="p-3 block w-full rounded" />
                            </div>
                        </div>
                        <button type="submit" class="mt-5 px-6 py-2 text-white bg-green-600 rounded-md hover:bg-green-700">Save</button>
                    </EditForm>
                </div>
            }

            <div class="rounded-t mb-0 px-4 py-3 border-0">
                <div class="flex flex-wrap items-center">
                    <div class="relative w-full px-4 max-w-full flex-grow flex-1">
                        <input placeholder="Filter by name" @bind="FilterName" @bind:event="oninput"
                               class="p-3 appearance-none block w-full md:w-1/2 text-gray-700 rounded leading-tight" />
                    </div>
                </div>
            </div>

            <div class="block w-full overflow-x-auto">
                <table class="items-center bg-transparent w-full border-collapse ">
                    <thead>
                        <tr>
                            <th class="px-6 bg-blueGray-50 dark:text-gray-200 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">
                            </th>
                            <th class="px-6 bg-blueGray-50 dark:text-gray-200 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">
                                Name
                            </th>
                            <th class="px-6 bg-blueGray-50 dark:text-gray-200 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">
                                Email
                            </th>
                            <th class="px-6 bg-blueGray-50 dark:text-gray-200 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">
                                Phone
                            </th>
                            <th class="px-6 bg-blueGray-50 dark:text-gray-200 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">
                                Orders
                            </th>
                            <th></th>
                            <th class="px-6 bg-blueGray-50 dark:text-gray-200 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">
                                Edit
                            </th>
                            <th class="px-6 bg-blueGray-50 text-red-400 align-middle border border-solid border-blueGray-100 py-3 text-xs uppercase border-l-0 border-r-0 whitespace-nowrap font-semibold text-left">
                                Delete
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in _State.AdminState.AllUsers)
                        {
                            <tr hidden="@(!string.IsNullOrEmpty(FilterName) && !$"{user.FirstName.ToLower()} {user.LastName.ToLower()}".Contains(FilterName.ToLower()))">
                                <th>
                                    <input type="radio" name="users-grp" @onclick="() => SelectUser(user)" />
                                </th>
                                <th class="dark:text-gray-200 border-t-0 px-6 align-middle border-l-0 border-r-0 text-xs whitespace-nowrap p-4 text-left text-blueGray-700">
                                    @if (user.IsAdmin)
                                    {
                                        <b>A &nbsp;</b>
                                    }
                                    @user.FirstName @user.LastName
                                </th>
                                <td class="dark:text-gray-300 border-t-0 px-6 align-middle border-l-0 border-r-0 text-xs whitespace-nowrap p-4">
                                    <a href="mailto:@user.Email">
                                        @user.Email
                                    </a>
                                </td>
                                <td class="dark:text-gray-300 border-t-0 px-6 border-l-0 border-r-0 text-xs whitespace-nowrap p-4">
                                    <a href="tel:@user.PhoneNumber">
                                        <i class="fas fa-phone"></i> @user.PhoneNumber
                                    </a>
                                </td>
                                <td class="dark:text-gray-300 border-t-0 px-6 border-l-0 border-r-0 text-xs whitespace-nowrap p-4 align-middle">
                                    <NavLink href=@string.Format($"/admin/orders/{user.Id}")>
                                        <i class="fas fa-external-link-square-alt">
                                        </i>
                                    </NavLink>
                                </td>
                                <td class="dark:text-gray-300 border-t-0 px-6 border-l-0 border-r-0 text-xs whitespace-nowrap p-4 align-middle">
                                    <a href=@string.Format($"/forgotpassword/{user.Id}")
                                       target="_blank">
                                        <i class="fas fa-unlock">
                                        </i>
                                    </a>
                                </td>

                                <td class="dark:text-gray-300 border-t-0 px-6 border-l-0 border-r-0 text-xs whitespace-nowrap p-4 align-middle">
                                    <button type="button" @onclick="() => BeginEdit(user)" class="text-blue-500 hover:text-blue-700">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                </td>

                                <td class="dark:text-gray-300 border-t-0 px-6 border-l-0 border-r-0 text-xs whitespace-nowrap p-4 align-middle">
                                    @if (!user.IsAdmin)
                                    {
                                        <i @onclick="() => RemoveUser(user)" class="fas fa-trash text-red-400 cursor-pointer"></i>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>


    @if (_SelectedUser != null)
    {
        <button @onclick="LoginAsUser"
                class="fixed bottom-2 right-2 z-50 px-4 py-1 shadow-lg text-sm text-white bg-green-600 rounded-md hover:bg-green-700">
            Login as @($"{_SelectedUser.FirstName[0]}.{_SelectedUser.LastName[0]}")
        </button>
    }
</section>



@code
{
    [Inject]
    public IJSRuntime JS { get; set; }
    [Inject]
    NavigationManager _NavManager { get; set; }

    string _FilterName = "";

    public string FilterName
    {
        get => _FilterName;
        set => SetProperty(ref _FilterName, value);
    }

    User? _SelectedUser;
    User? _EditingUser;
    string _EditingPassword = "";

    void SelectUser(User user)
    {
        _SelectedUser = user;
    }

    void BeginEdit(User user)
    {
        _EditingUser = user.Clone();
        _EditingPassword = "";
    }

    void CancelEdit()
    {
        _EditingUser = null;
        _EditingPassword = "";
    }

    async Task SaveUser(EditContext _)
    {
        if (_EditingUser is null)
            return;

        try
        {
            var updatedUser = await MainService.UpdateUserAsync(_EditingUser, _EditingPassword);
            if (!updatedUser)
                return;

            MainService.AddAlert(new Alert("Success", "User updated successfully", AlertType.Success));
            CancelEdit();
        }
        catch (Exception e)
        {
            MainService.AddAlert(new Alert("Error", e.Message, AlertType.Error));
        }
    }

    async void LoginAsUser()
    {
        if (_SelectedUser != null)
        {
            await MainService.LoginAsUser(_SelectedUser);
            _NavManager.NavigateTo("/");
        }
    }

    async void RemoveUser(User? user)
    {
        if (user is not null && await JS.InvokeAsync<bool>(Constants.JavaScriptFunctions.Confirm, $"To delete {user.FirstName}?"))
        {
            await MainService.RemoveUserAsync(user);
        }
    }
}
